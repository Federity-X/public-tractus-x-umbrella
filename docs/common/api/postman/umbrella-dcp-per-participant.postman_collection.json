                  "pm.collectionVariables.set('run_id', rid);",
                  "pm.collectionVariables.set('asset_id', 'pm-asset-' + rid);",
                  "pm.collectionVariables.set('access_policy_id', 'pm-access-' + rid);",
                  "pm.collectionVariables.set('usage_policy_id', 'pm-usage-' + rid);",
                  "pm.collectionVariables.set('contract_def_id', 'pm-contract-' + rid);",
                  "['offer_id','negotiation_id','transfer_process_id','edr_endpoint','edr_token'].forEach(k => pm.collectionVariables.set(k, ''));",
                  "['neg_poll_count','edr_poll_count','da_poll_count','neg_retry'].forEach(k => pm.collectionVariables.set(k, 0));",
                  "console.log('=== new run', rid, '===');"
                ]
              }
