    {
      "name": "6-8 - Catalog & Negotiation",
      "item": [
        {
          "name": "6 - Request Catalog",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('catalog 2xx (DCP auth + VP presentation worked)', function () {",
                  "  pm.expect(pm.response.code, 'catalog returned ' + pm.response.code).to.be.within(200,299);",
                  "});",
                  "let j = {}; try { j = pm.response.json(); } catch (e) {}",
                  "let ds = j.dataset; if (Array.isArray(ds)) ds = ds[0];",
                  "let hp = ds && ds.hasPolicy; if (Array.isArray(hp)) hp = hp[0];",
                  "const offerId = hp && hp['@id'];",
                  "pm.test('offer advertised for asset (policy matched)', function () {",
                  "  pm.expect(offerId, 'no offer for asset - contract definition/policy not matched').to.be.a('string').and.to.have.length.above(0);",
                  "});",
                  "if (offerId) { pm.collectionVariables.set('offer_id', offerId); console.log('offer_id =', offerId); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Api-Key",
                "value": "{{consumer_api_key}}"
              }
            ],
            "url": "{{consumer_mgmt}}/catalog/request",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"@context\": [{\"@vocab\": \"https://w3id.org/edc/v0.0.1/ns/\"}],\n  \"@type\": \"CatalogRequest\",\n  \"counterPartyAddress\": \"{{provider_dsp}}/{{dsp_version}}\",\n  \"counterPartyId\": \"{{provider_did}}\",\n  \"protocol\": \"{{dsp_protocol}}\",\n  \"querySpec\": {\"offset\": 0, \"limit\": 50, \"filterExpression\": [\n    {\"operandLeft\": \"https://w3id.org/edc/v0.0.1/ns/id\", \"operator\": \"=\", \"operandRight\": \"{{asset_id}}\"}]}\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "7 - Start EDR Negotiation",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('negotiation accepted (2xx)', function () {",
                  "  pm.expect(pm.response.code).to.be.within(200,299);",
                  "});",
                  "const j = pm.response.json();",
                  "const negId = j['@id'];",
                  "pm.test('negotiation @id present', function () {",
                  "  pm.expect(negId).to.be.a('string').and.to.have.length.above(0);",
                  "});",
                  "pm.collectionVariables.set('negotiation_id', negId);",
                  "pm.collectionVariables.set('neg_poll_count', 0);",
                  "pm.collectionVariables.set('edr_poll_count', 0);",
                  "pm.collectionVariables.set('da_poll_count', 0);",
                  "console.log('negotiation_id =', negId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Api-Key",
                "value": "{{consumer_api_key}}"
              }
            ],
            "url": "{{consumer_mgmt}}/edrs",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"@context\": [\"http://www.w3.org/ns/odrl.jsonld\",\n    \"https://w3id.org/catenax/2025/9/policy/context.jsonld\",\n    {\"@vocab\": \"https://w3id.org/edc/v0.0.1/ns/\"}],\n  \"@type\": \"ContractRequest\",\n  \"counterPartyAddress\": \"{{provider_dsp}}/{{dsp_version}}\",\n  \"protocol\": \"{{dsp_protocol}}\",\n  \"policy\": {\"@id\": \"{{offer_id}}\", \"@type\": \"Offer\", \"assigner\": \"{{provider_did}}\", \"target\": \"{{asset_id}}\",\n    \"permission\": [{\"action\": \"use\", \"constraint\": [{\"and\": [\n      {\"leftOperand\": \"Membership\", \"operator\": \"eq\", \"rightOperand\": \"active\"},\n      {\"leftOperand\": \"FrameworkAgreement\", \"operator\": \"eq\", \"rightOperand\": \"{{framework_agreement}}\"},\n      {\"leftOperand\": \"UsagePurpose\", \"operator\": \"isAnyOf\", \"rightOperand\": \"{{usage_purpose}}\"}\n    ]}]}], \"prohibition\": [], \"obligation\": []},\n  \"callbackAddresses\": []\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "8 - Poll Negotiation State",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const _setNext = (n) => { try { pm.execution.setNextRequest(n); } catch (e) { postman.setNextRequest(n); } };",
                  "const j = pm.response.json();",
                  "const state = j.state || j['edc:state'] || '';",
                  "const max = parseInt(pm.variables.get('max_poll') || '40', 10);",
                  "let n = parseInt(pm.collectionVariables.get('neg_poll_count') || '0', 10) + 1;",
                  "pm.collectionVariables.set('neg_poll_count', n);",
                  "console.log('negotiation state =', state, '(' + n + '/' + max + ')');",
                  "if (state === 'FINALIZED') {",
                  "  pm.test('negotiation FINALIZED', function () { pm.expect(true).to.be.true; });",
                  "} else if (state === 'TERMINATED' || state === 'ERROR') {",
                  "  pm.test('negotiation reached a non-terminal state', function () {",
                  "    pm.expect.fail('negotiation ' + state + ' - policy not satisfied / credential rejected');",
                  "  });",
                  "  _setNext(null);",
                  "} else if (n < max) {",
                  "  _setNext('8 - Poll Negotiation State');",
                  "} else {",
                  "  pm.test('negotiation finalized within poll budget', function () {",
                  "    pm.expect.fail('negotiation did not finalize (last state ' + (state || 'unknown') + ')');",
                  "  });",
                  "  _setNext(null);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{consumer_api_key}}"
              }
            ],
            "url": "{{consumer_mgmt}}/contractnegotiations/{{negotiation_id}}"
          }
        }
      ]
    },
    {
      "name": "9-11 - Transfer & Fetch",
      "item": [
        {
          "name": "9 - Query Cached EDR",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const _setNext = (n) => { try { pm.execution.setNextRequest(n); } catch (e) { postman.setNextRequest(n); } };",
                  "let r = {}; try { r = pm.response.json(); } catch (e) {}",
                  "if (Array.isArray(r)) r = r[0] || {};",
                  "const tp = r.transferProcessId || r['tx:transferProcessId'];",
                  "const maxEdr = parseInt(pm.variables.get('max_edr_poll') || '10', 10);",
                  "const maxNegRetry = parseInt(pm.variables.get('max_neg_retry') || '2', 10);",
                  "let p = parseInt(pm.collectionVariables.get('edr_poll_count') || '0', 10) + 1;",
                  "pm.collectionVariables.set('edr_poll_count', p);",
                  "if (tp) {",
                  "  pm.collectionVariables.set('transfer_process_id', tp);",
                  "  pm.collectionVariables.set('da_poll_count', 0);",
                  "  pm.test('EDR cached (transfer started)', function () { pm.expect(true).to.be.true; });",
                  "  console.log('transfer_process_id =', tp);",
                  "} else if (p < maxEdr) {",
                  "  console.log('EDR not cached yet (' + p + '/' + maxEdr + ') - polling');",
                  "  _setNext('9 - Query Cached EDR');",
                  "} else {",
                  "  let nr = parseInt(pm.collectionVariables.get('neg_retry') || '0', 10) + 1;",
                  "  pm.collectionVariables.set('neg_retry', nr);",
                  "  if (nr < maxNegRetry) {",
                  "    console.log('no EDR after ' + maxEdr + ' polls - cold-BDRS-cache race; re-negotiating (retry ' + nr + ')');",
                  "    _setNext('7 - Start EDR Negotiation');",
                  "  } else {",
                  "    pm.test('EDR appeared in cache', function () {",
                  "      pm.expect.fail('no EDR after ' + maxNegRetry + ' negotiations - transfer kept terminating (check provider for \"No BPN entry found\")');",
                  "    });",
                  "    _setNext(null);",
                  "  }",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Api-Key",
                "value": "{{consumer_api_key}}"
              }
            ],
            "url": "{{consumer_mgmt}}/edrs/request",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"@context\": {\"@vocab\": \"https://w3id.org/edc/v0.0.1/ns/\"},\n  \"@type\": \"QuerySpec\",\n  \"filterExpression\": [{\"operandLeft\": \"contractNegotiationId\", \"operator\": \"=\", \"operandRight\": \"{{negotiation_id}}\"}]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "9b - Diagnose Transfer State (run if EDR stays empty)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "let r = []; try { r = pm.response.json(); } catch (e) {}",
                  "if (!Array.isArray(r)) r = [r];",
                  "if (!r.length) {",
                  "  pm.test('a transfer process exists', function () {",
                  "    pm.expect.fail('no transfer process yet - the negotiation may not have triggered a transfer; re-send \"9 - Query Cached EDR\"');",
                  "  });",
                  "} else {",
                  "  const tp = r[0];",
                  "  const state = tp.state || tp['edc:state'];",
                  "  let err = tp.errorDetail || tp['edc:errorDetail'];",
                  "  if (Array.isArray(err)) err = err.map(function (e) { return e['@value'] || e; }).join('; ');",
                  "  console.log('latest transfer state =', state, '| errorDetail =', err || '(none)');",
                  "  pm.test('transfer is not TERMINATED', function () {",
                  "    pm.expect(state, 'transfer ' + state + (err ? ': ' + err : '') + ' || If \"No BPN entry found\": the BDRS directory is missing the BPN->DID mapping (cold or empty in-memory BDRS). Re-seed BDRS (re-run the post-install-bdrs-setup hook, e.g. `helm upgrade` - see the deploy guide \"Re-seeding after a pod restart\"), then re-run from step 7.').to.not.equal('TERMINATED');",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Api-Key",
                "value": "{{consumer_api_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"@context\": {\"@vocab\": \"https://w3id.org/edc/v0.0.1/ns/\"},\n  \"@type\": \"QuerySpec\", \"sortField\": \"stateTimestamp\", \"sortOrder\": \"DESC\", \"limit\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{consumer_mgmt}}/transferprocesses/request"
          }
        },
        {
          "name": "10 - Get EDR Data Address",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const _setNext = (n) => { try { pm.execution.setNextRequest(n); } catch (e) { postman.setNextRequest(n); } };",
                  "let j = {}; try { j = pm.response.json(); } catch (e) {}",
                  "const endpoint = j.endpoint;",
                  "const token = j.authorization;",
                  "const max = parseInt(pm.variables.get('max_poll') || '40', 10);",
                  "let n = parseInt(pm.collectionVariables.get('da_poll_count') || '0', 10) + 1;",
                  "pm.collectionVariables.set('da_poll_count', n);",
                  "if (endpoint && token) {",
                  "  pm.collectionVariables.set('edr_endpoint', endpoint);",
                  "  pm.collectionVariables.set('edr_token', token);",
                  "  pm.test('EDR data address + token resolved', function () { pm.expect(true).to.be.true; });",
                  "  console.log('edr_endpoint =', endpoint);",
                  "} else if (n < max) {",
                  "  console.log('EDR data address not ready yet (' + n + '/' + max + ') - polling');",
                  "  _setNext('10 - Get EDR Data Address');",
                  "} else {",
                  "  pm.test('EDR data address resolved', function () {",
                  "    pm.expect.fail('could not resolve EDR endpoint/token for the transfer process');",
                  "  });",
                  "  _setNext(null);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "X-Api-Key",
                "value": "{{consumer_api_key}}"
              }
            ],
            "url": "{{consumer_mgmt}}/edrs/{{transfer_process_id}}/dataaddress?auto_refresh=true"
          }
        },
        {
          "name": "11 - Fetch Asset Data",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('data fetch 2xx', function () { pm.expect(pm.response.code).to.be.within(200,299); });",
                  "const marker = pm.variables.get('data_marker');",
                  "const body = pm.response.text();",
                  "pm.test('payload contains the data marker (real end-to-end transfer)', function () {",
                  "  pm.expect(body).to.include(marker);",
                  "});",
                  "if (pm.response.code < 300 && body.indexOf(marker) >= 0) {",
                  "  console.log('FULL DCP DATA TRANSFER SUCCEEDED - consumer fetched the provider asset over DCP.');",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "{{edr_token}}"
              }
            ],
            "url": "{{edr_endpoint}}/{{data_path}}"
          }
        }
      ]
    }
